# -----------------------------------------------------------------------------
# SBDC Portal - Environment Variables
# -----------------------------------------------------------------------------

# Resend API Key for Transactional Emails (Required in production)
# Get your API key at: https://resend.com/api-keys
RESEND_API_KEY="re_your_api_key_here"

# Sender Address for Transactional Emails (Optional)
# In development/sandbox testing, use: "Surya BDC <onboarding@resend.dev>"
# Once your domain (suryabdc.com.np) is verified in Resend, use: "Surya BDC <contact@suryabdc.com.np>"
RESEND_FROM_EMAIL="Surya BDC <noreply@suryabdc.com.np>"

# Destination Email for Internal Contact Inquiries (Optional, defaults to suryabusinessdc@gmail.com)
CONTACT_TO_EMAIL="suryabusinessdc@gmail.com"
